# ----------------------------------------------------------------------------
#  ARGUS API — variáveis de ambiente (copie para backend/.env)
# ----------------------------------------------------------------------------

# Conexão usada pela API. Use um role SEM privilégio de dono/superuser
# (ex.: argus_app) para que o Row Level Security isole as óticas.
DATABASE_URL=postgres://argus_app:argus_app@localhost:5432/argus?sslmode=disable

# Conexão do dono das tabelas: se definida, a API aplica as migrations no boot
# e concede acesso ao APP_DB_ROLE. Também usada por cmd/migrate e cmd/seed.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/argus?sslmode=disable
APP_DB_ROLE=argus_app

# JWT (mínimo 32 caracteres — gere com: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-256-bit-random-secret-min32!!
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Cookie do refresh token: true em produção (HTTPS). Use false só em dev via http.
COOKIE_SECURE=false

PORT=8080
GIN_MODE=debug
APP_TIMEZONE=America/Sao_Paulo
# Origens do front (separadas por vírgula). Em dev o Vite faz proxy de /api,
# então normalmente não é necessário.
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_RATE=20
RATE_LIMIT_BURST=100
LOGIN_RATE_PER_MINUTE=20
REGISTER_RATE_PER_HOUR=10
